<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>V-STAR Project & Activity Board</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
  <link href="https://fonts.googleapis.com/css2?family=Kanit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Kanit', sans-serif; }
  </style>
</head>
<body class="bg-gray-100 min-h-screen flex flex-col">

  <header class="bg-[#ef4444] text-white shadow-md sticky top-0 z-50">
    <div class="max-w-4xl mx-auto px-4 py-3 flex justify-between items-center">
      <div class="flex items-center space-x-2">
        <span class="text-2xl font-black italic tracking-wider bg-white text-red-600 px-2 py-0.5 rounded">V STAR</span>
        <span class="text-xs hidden sm:inline border-l border-red-300 pl-2">ดาวแห่งความดี ผู้นำศีลธรรมโลก</span>
      </div>
      <div class="flex items-center space-x-2 text-sm">
        <button onclick="switchTab('activities')" class="px-3 py-1.5 rounded hover:bg-red-600 font-medium">กิจกรรม</button>
        <button onclick="switchTab('register')" class="px-3 py-1.5 rounded hover:bg-red-600 font-medium">กรอกข้อมูลส่วนตัว</button>
        <button onclick="switchTab('admin')" class="px-3 py-1.5 bg-red-800 rounded hover:bg-red-900 font-medium">หลังบ้าน (Admin)</button>
        <button id="auth-btn" onclick="openAuthModal()" class="px-3 py-1.5 bg-white text-red-600 rounded font-semibold hover:bg-gray-100">เข้าสู่ระบบ</button>
      </div>
    </div>
  </header>

  <main class="max-w-4xl mx-auto w-full flex-grow p-4">

    <section id="sec-activities" class="space-y-6">
      <div class="flex justify-between items-center border-b pb-3">
        <h1 class="text-xl font-bold text-gray-800 flex items-center gap-2">
          <span>☑</span> กิจกรรมทั้งหมด
        </h1>
        <div class="flex gap-2">
          <button class="px-4 py-1.5 bg-red-500 text-white text-sm rounded-md font-medium">การ์ด</button>
          <button class="px-4 py-1.5 bg-white text-gray-600 border text-sm rounded-md font-medium">ตาราง</button>
        </div>
      </div>

      <div class="bg-white rounded-xl shadow-sm border overflow-hidden">
        <img src="https://images.unsplash.com/photo-1517245386807-bb43f82c33c4?auto=format&fit=crop&w=800&q=80" alt="SYLT" class="w-full h-48 object-cover">
        <div class="p-4 space-y-2">
          <h2 class="text-lg font-bold text-blue-600">Smart Young Leader Thailand ค่ายพัฒนาศักยภาพผู้นำเยาวชนต้นแบบด้านศีลธรรมระดับประเทศ (รุ่น ม.ปลาย)</h2>
          <p class="text-xs font-semibold text-blue-500">SYLT</p>
          <div class="text-xs text-gray-600 space-y-1">
            <p>📅 12 - 16 ต.ค. 69</p>
            <p>📍 World Peace Valley เขาใหญ่ จ.นครราชสีมา</p>
            <p>👥 ชาย 69 หญิง 108 รวม 177</p>
          </div>
          <div class="pt-2 border-t flex items-center justify-between">
            <button onclick="switchTab('register')" class="bg-red-500 hover:bg-red-600 text-white px-4 py-2 rounded-lg text-sm font-medium">
              สมัครกิจกรรมนี้
            </button>
          </div>
        </div>
      </div>

      <div class="bg-white rounded-xl shadow-sm border overflow-hidden">
        <div class="bg-blue-900 text-white p-6 text-center">
          <h3 class="text-xl font-bold">SUPER LEADER</h3>
          <p class="text-xs mt-1">ผู้นำจิตอาสา อุทิศตน ทำความดี</p>
        </div>
        <div class="p-4 space-y-2">
          <h2 class="text-lg font-bold text-blue-600">อาสาสมัครจัดภัตตาหาร ต้นเดือนกุมภาพันธ์</h2>
          <p class="text-xs font-semibold text-blue-500">R-Sa Smart เครือข่ายเยาวชนจิตอาสา</p>
          <button onclick="switchTab('register')" class="mt-2 bg-red-500 hover:bg-red-600 text-white px-4 py-2 rounded-lg text-sm font-medium">
            สมัครกิจกรรมนี้
          </button>
        </div>
      </div>
    </section>

    <section id="sec-register" class="hidden space-y-4">
      <div class="bg-white rounded-xl shadow-sm border p-6">
        <h2 class="text-lg font-bold text-gray-700 border-b pb-3 mb-4 flex items-center gap-2">
          👤 ข้อมูลส่วนตัว / เพิ่มข้อมูลผู้ร่วมกิจกรรม
        </h2>
        
        <form id="personForm" onsubmit="handleFormSubmit(event)" class="space-y-4">
          <div>
            <label class="block text-sm font-medium text-gray-700">คำนำหน้า <span class="text-red-500">*</span></label>
            <select id="prefix" required class="mt-1 w-full border border-gray-300 rounded-lg p-2.5 text-sm focus:ring-2 focus:ring-red-500 outline-none">
              <option value="">เลือก</option>
              <option value="นาย">นาย</option>
              <option value="น.ส.">น.ส.</option>
              <option value="ด.ช.">ด.ช.</option>
              <option value="ด.ญ.">ด.ญ.</option>
            </select>
          </div>

          <div>
            <label class="block text-sm font-medium text-gray-700">ชื่อ <span class="text-red-500">*</span></label>
            <input type="text" id="firstName" required class="mt-1 w-full border border-gray-300 rounded-lg p-2.5 text-sm focus:ring-2 focus:ring-red-500 outline-none">
          </div>

          <div>
            <label class="block text-sm font-medium text-gray-700">นามสกุล <span class="text-red-500">*</span></label>
            <input type="text" id="lastName" required class="mt-1 w-full border border-gray-300 rounded-lg p-2.5 text-sm focus:ring-2 focus:ring-red-500 outline-none">
          </div>

          <div>
            <label class="block text-sm font-medium text-gray-700">ชื่อเล่น <span class="text-red-500">*</span></label>
            <input type="text" id="nickname" required class="mt-1 w-full border border-gray-300 rounded-lg p-2.5 text-sm focus:ring-2 focus:ring-red-500 outline-none">
          </div>

          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="block text-sm font-medium text-gray-700">ระดับชั้น / สถานะ</label>
              <input type="text" id="grade" placeholder="เช่น ม.5 หรือ ป.5" class="mt-1 w-full border border-gray-300 rounded-lg p-2.5 text-sm focus:ring-2 focus:ring-red-500 outline-none">
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700">เบอร์โทรศัพท์ <span class="text-red-500">*</span></label>
              <input type="tel" id="phone" required placeholder="08XXXXXXXX" class="mt-1 w-full border border-gray-300 rounded-lg p-2.5 text-sm focus:ring-2 focus:ring-red-500 outline-none">
            </div>
          </div>

          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="block text-sm font-medium text-gray-700">วัน/เดือน/ปีเกิด <span class="text-red-500">*</span></label>
              <input type="date" id="birthDate" required class="mt-1 w-full border border-gray-300 rounded-lg p-2.5 text-sm focus:ring-2 focus:ring-red-500 outline-none">
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700">เพศ <span class="text-red-500">*</span></label>
              <select id="gender" required class="mt-1 w-full border border-gray-300 rounded-lg p-2.5 text-sm focus:ring-2 focus:ring-red-500 outline-none">
                <option value="">เลือก</option>
                <option value="ชาย">ชาย</option>
                <option value="หญิง">หญิง</option>
              </select>
            </div>
          </div>

          <div>
            <label class="block text-sm font-medium text-gray-700">โรงเรียน / สถานศึกษา</label>
            <input type="text" id="school" placeholder="เช่น โรงเรียนหอวัง ปทุมธานี" class="mt-1 w-full border border-gray-300 rounded-lg p-2.5 text-sm focus:ring-2 focus:ring-red-500 outline-none">
          </div>

          <button type="submit" class="w-full bg-red-500 text-white font-medium py-3 rounded-lg hover:bg-red-600 transition">
            บันทึกข้อมูลการสมัคร
          </button>
        </form>
      </div>
    </section>

    <section id="sec-admin" class="hidden space-y-4">
      <div class="bg-white rounded-xl shadow-sm border p-4 flex justify-between items-center">
        <div>
          <h2 class="text-lg font-bold text-gray-800">ระบบหลังบ้าน (Admin Dashboard)</h2>
          <p class="text-xs text-gray-500">ตรวจสอบรายชื่อและรายละเอียดผู้สมัครทั้งหมด</p>
        </div>
        <div class="bg-red-100 text-red-700 font-bold px-4 py-2 rounded-lg text-sm">
          จำนวนผู้สมัครทั้งหมด: <span id="applicant-count">0</span> คน
        </div>
      </div>

      <div id="applicant-list" class="space-y-3">
        </div>
    </section>

  </main>

  <div id="auth-modal" class="fixed inset-0 bg-black bg-opacity-50 hidden flex items-center justify-center p-4 z-50">
    <div class="bg-white w-full max-w-md rounded-xl p-6 shadow-xl relative">
      <button onclick="closeAuthModal()" class="absolute top-3 right-3 text-gray-400 hover:text-gray-600">✕</button>
      <h3 class="text-xl font-bold text-gray-800 mb-4" id="modal-title">เข้าสู่ระบบ (Supabase Auth)</h3>
      
      <div class="space-y-4">
        <div>
          <label class="block text-sm font-medium text-gray-700">อีเมล</label>
          <input type="email" id="auth-email" class="w-full border rounded-lg p-2.5 text-sm mt-1">
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700">รหัสผ่าน</label>
          <input type="password" id="auth-password" class="w-full border rounded-lg p-2.5 text-sm mt-1">
        </div>
        <div class="flex gap-2">
          <button onclick="handleLogin()" class="flex-1 bg-red-500 text-white py-2 rounded-lg font-medium hover:bg-red-600">เข้าสู่ระบบ</button>
          <button onclick="handleSignUp()" class="flex-1 bg-gray-200 text-gray-700 py-2 rounded-lg font-medium hover:bg-gray-300">สมัครสมาชิก</button>
        </div>
      </div>
    </div>
  </div>

  <script>
    // -------------------------------------------------------------
    // 1. กำหนดค่า Supabase (ใส่ URL และ Anon Key ของคุณตรงนี้)
    // -------------------------------------------------------------
    const SUPABASE_URL = "https://YOUR_SUPABASE_PROJECT_ID.supabase.co";
    const SUPABASE_ANON_KEY = "YOUR_SUPABASE_ANON_KEY";
    
    // สร้างตัวแปร Supabase Client
    const supabaseClient = supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);

    let currentUser = null;

    // ตรวจสอบสถานะการ Login เมื่อเปิดหน้าเว็บ
    window.onload = async () => {
      const { data: { user } } = await supabaseClient.auth.getUser();
      if (user) {
        currentUser = user;
        document.getElementById('auth-btn').innerText = `ผู้ใช้: ${user.email.split('@')[0]}`;
      }
      loadApplicants();
    };

    // -------------------------------------------------------------
    // 2. ระบบสลับ Tap/View หน้าจอ
    // -------------------------------------------------------------
    function switchTab(tabName) {
      document.getElementById('sec-activities').classList.add('hidden');
      document.getElementById('sec-register').classList.add('hidden');
      document.getElementById('sec-admin').classList.add('hidden');

      if (tabName === 'activities') document.getElementById('sec-activities').classList.remove('hidden');
      if (tabName === 'register') document.getElementById('sec-register').classList.remove('hidden');
      if (tabName === 'admin') {
        document.getElementById('sec-admin').classList.remove('hidden');
        loadApplicants(); // โหลดข้อมูลใหม่เมื่อกดหน้าหลังบ้าน
      }
    }

    // Modal Control
    function openAuthModal() { document.getElementById('auth-modal').classList.remove('hidden'); }
    function closeAuthModal() { document.getElementById('auth-modal').classList.add('hidden'); }

    // -------------------------------------------------------------
    // 3. Supabase Authentication (สมัคร / ล็อกอิน)
    // -------------------------------------------------------------
    async function handleSignUp() {
      const email = document.getElementById('auth-email').value;
      const password = document.getElementById('auth-password').value;
      const { data, error } = await supabaseClient.auth.signUp({ email, password });
      if (error) alert("เกิดข้อผิดพลาด: " + error.message);
      else {
        alert("สมัครสมาชิกสำเร็จ! กรุณาตรวจสอบอีเมลเพื่อยืนยัน หรือลองเข้าสู่ระบบ");
        closeAuthModal();
      }
    }

    async function handleLogin() {
      const email = document.getElementById('auth-email').value;
      const password = document.getElementById('auth-password').value;
      const { data, error } = await supabaseClient.auth.signInWithPassword({ email, password });
      if (error) alert("เข้าสู่ระบบไม่สำเร็จ: " + error.message);
      else {
        currentUser = data.user;
        document.getElementById('auth-btn').innerText = `ผู้ใช้: ${currentUser.email.split('@')[0]}`;
        alert("เข้าสู่ระบบสำเร็จ!");
        closeAuthModal();
      }
    }

    // -------------------------------------------------------------
    // 4. ระบบบันทึกข้อมูลส่วนตัวผู้สมัคร (Insert Data)
    // -------------------------------------------------------------
    async function handleFormSubmit(e) {
      e.preventDefault();
      
      const formData = {
        prefix: document.getElementById('prefix').value,
        first_name: document.getElementById('firstName').value,
        last_name: document.getElementById('lastName').value,
        nickname: document.getElementById('nickname').value,
        grade: document.getElementById('grade').value,
        phone: document.getElementById('phone').value,
        birth_date: document.getElementById('birthDate').value,
        gender: document.getElementById('gender').value,
        school: document.getElementById('school').value,
        user_id: currentUser ? currentUser.id : null
      };

      const { data, error } = await supabaseClient
        .from('participants')
        .insert([formData]);

      if (error) {
        alert("ไม่สามารถบันทึกข้อมูลได้: " + error.message);
      } else {
        alert("บันทึกข้อมูลสมัครเรียบร้อยแล้ว!");
        document.getElementById('personForm').reset();
        switchTab('admin'); // ย้ายไปหน้าหลังบ้านเพื่อดูข้อมูล
      }
    }

    // -------------------------------------------------------------
    // 5. ระบบดึงข้อมูลผู้สมัครมาแสดงในหน้า Admin Dashboard (Fetch Data)
    // -------------------------------------------------------------
    async function loadApplicants() {
      const { data: participants, error, count } = await supabaseClient
        .from('participants')
        .select('*', { count: 'exact' })
        .order('created_at', { ascending: false });

      if (error) {
        console.error("Fetch Error:", error);
        return;
      }

      document.getElementById('applicant-count').innerText = count || (participants ? participants.length : 0);
      const listContainer = document.getElementById('applicant-list');
      listContainer.innerHTML = '';

      if (!participants || participants.length === 0) {
        listContainer.innerHTML = `<div class="bg-white p-6 text-center text-gray-500 rounded-xl">ยังไม่มีผู้สมัครในระบบ</div>`;
        return;
      }

      participants.forEach((person, idx) => {
        const cardHtml = `
          <div class="bg-white p-4 rounded-xl shadow-sm border flex justify-between items-start">
            <div class="flex gap-3">
              <div class="w-12 h-12 bg-gray-200 rounded-full flex items-center justify-center text-gray-400 font-bold text-xl">
                👤
              </div>
              <div class="space-y-1">
                <div class="flex items-center gap-2">
                  <span class="font-bold text-gray-800 text-base">${person.prefix}${person.first_name} ${person.last_name}</span>
                  <span class="bg-red-50 text-red-600 text-xs px-2 py-0.5 rounded-full font-medium">${person.grade || 'นักเรียน'}</span>
                </div>
                <div class="text-xs text-blue-600 flex items-center gap-2">
                  <span>📱 ${person.phone}</span>
                  <span>🎂 ${person.birth_date || 'ไม่ระบุวันเกิด'}</span>
                </div>
                <p class="text-xs text-gray-600">${person.school || 'ไม่ได้ระบุโรงเรียน'}</p>
              </div>
            </div>
            
            <div class="flex flex-col items-end gap-2">
              <label class="flex items-center gap-1.5 text-xs text-amber-600 bg-amber-50 px-2 py-1 rounded cursor-pointer">
                <input type="checkbox" ${person.is_confirmed ? 'checked' : ''} onchange="toggleConfirm('${person.id}', this.checked)" class="rounded text-amber-500">
                <span class="font-semibold">Confirm</span>
              </label>
              <span class="text-[10px] text-gray-400">#${idx + 1}</span>
            </div>
          </div>
        `;
        listContainer.insertAdjacentHTML('beforeend', cardHtml);
      });
    }

    // ฟังก์ชันอัปเดตสถานะ Confirm ของผู้สมัคร
    async function toggleConfirm(id, isChecked) {
      await supabaseClient
        .from('participants')
        .update({ is_confirmed: isChecked })
        .eq('id', id);
    }
  </script>
</body>
</html>
